{
  // The egress firewall is an opt-in recipe (docs/template/docs-toolchain.md, "Sandbox agents
  // in a devcontainer"). Features float on their major like the image tag, so a rebuild takes
  // their updates; a new major is a hand edit, and the Claude Code feature tracks the CLI's releases.
  "image": "mcr.microsoft.com/devcontainers/typescript-node:24-bookworm",
  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "containerEnv": { "pnpm_config_store_dir": "/home/node/.local/share/pnpm/store" },
  "postCreateCommand": "sudo chown node:node /home/node/.local /home/node/.local/share /home/node/.local/share/pnpm && pnpm install",
  "remoteUser": "node",
  // The two VitePress dev servers (internal, then public) bind the next free port from 5173.
  "forwardPorts": [5173, 5174],
  "mounts": ["source=roots-pnpm-store,target=/home/node/.local/share/pnpm,type=volume"],
  "customizations": {
    "vscode": {
      "extensions": ["editorconfig.editorconfig", "dbaeumer.vscode-eslint"]
    }
  }
}
