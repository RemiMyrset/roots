{
  // The egress firewall is an opt-in recipe (docs/template/docs-toolchain.md, "Sandbox agents
  // in a devcontainer"). Features float on their major like the image tag; Renovate
  // (renovate.json) proposes the bumps, and the Claude Code feature tracks the CLI's own releases.
  "image": "mcr.microsoft.com/devcontainers/typescript-node:24-bookworm",
  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "corepack enable && pnpm install",
  "remoteUser": "node",
  // The two VitePress dev servers (internal, then public) bind the next free port from 5173.
  "forwardPorts": [5173, 5174],
  // The pnpm store survives a container rebuild, so a rebuild re-links instead of re-downloading.
  "mounts": ["source=roots-pnpm-store,target=/home/node/.local/share/pnpm,type=volume"],
  "customizations": {
    "vscode": {
      "extensions": ["editorconfig.editorconfig", "dbaeumer.vscode-eslint"]
    }
  }
}
