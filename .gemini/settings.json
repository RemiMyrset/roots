{
  "context": {
    "fileName": [
      "AGENTS.md"
    ]
  },
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "run_shell_command",
        "hooks": [
          {
            "name": "guards",
            "type": "command",
            "command": "pnpm -w --silent run guards",
            "timeout": 10000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "name": "writing-rules",
            "type": "command",
            "command": "pnpm -w --silent run session",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
