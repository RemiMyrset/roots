{
  // Use the workspace TypeScript (5.9, matching `pnpm typecheck`) instead of the
  // editor's bundled compiler, which is older and mishandles this repo's config
  // (erasableSyntaxOnly, rewriteRelativeImportExtensions) — the cause of phantom
  // "Cannot find name 'console'/'process'" errors on scripts/*.mts while the CLI
  // is clean. VSCode prompts once per workspace to adopt it (one "Allow" click).
  // Both spellings on purpose: the unified `js/ts.*` keys (VSCode Feb-2026+) and the
  // classic `typescript.*` keys older editors still read.
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  // The antfu flat config; fix on save so the editor and `pnpm lint:fix` agree.
  "eslint.useFlatConfig": true,
  "editor.codeActionsOnSave": { "source.fixAll.eslint": "explicit" },
  // LF everywhere (the .gitattributes rule); keep the two site builds out of search.
  "files.eol": "\n",
  "search.exclude": { "**/.vitepress/dist": true, "**/.vitepress/cache": true }
}
