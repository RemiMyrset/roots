node_modules/
# pnpm's fallback store when the checkout is its own mount (a devcontainer without its store env)
.pnpm-store/
dist/
.turbo/
coverage/
*.tsbuildinfo
.DS_Store
Thumbs.db
.idea/

# VitePress cache (its dist/ output is covered by the dist/ rule above)
docs/**/.vitepress/cache/

# Environment files: never commit. The lowercase names mirror the secret-read guard: `.env` and
# `.envrc` alone or with a `.`, `-`, `_`, or `~` suffix (an editor backup, a direnv override), and
# never `.env*`, which would also catch `.environment`. `.env.example` is the one allowed
# exception; `pnpm test:gates` checks the set.
.env
.env.*
.env-*
.env_*
.env~*
.envrc
.envrc.*
.envrc-*
.envrc_*
.envrc~*
!.env.example

# Other secret material — the repo-shaped subset of the Read-deny + shell-guard secret set
# (the machine-credential files those cover live outside any repo), and keeps these out of
# the Grep/Glob tools (ripgrep skips gitignored paths).
secrets/
*.pem
*.key
*.p12
*.pfx
*.jks
.netrc
_netrc
.git-credentials
.pgpass
id_rsa
id_dsa
id_ecdsa
id_ed25519

# Obsidian per-user state (the committed app.json enforces portable links)
docs/.obsidian/*
!docs/.obsidian/app.json

# Per-developer Claude Code settings (team-wide settings.json IS committed)
.claude/settings.local.json
CLAUDE.local.md

# Claude Code worktrees: other checkouts, whose files are not this one's to scan or check
.claude/worktrees/
