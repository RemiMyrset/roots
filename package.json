{
  "name": "roots",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
  "description": "Rapid Opinionated Onboarding \u2014 TypeScript. Template repository seeding AI-agent-ready pnpm+turbo monorepos.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:hooks": "node scripts/test-hooks.mts",
    "typecheck": "tsc --noEmit && turbo run typecheck",
    "lint": "CI=1 eslint .",
    "lint:fix": "CI=1 eslint . --fix",
    "docs:gen": "automd && node scripts/docs/gen-llms.mts",
    "docs:check": "node scripts/docs/check-docs.mts",
    "docs:portability": "node scripts/docs/check-portability.mts",
    "docs:internal:dev": "vitepress dev docs/internal",
    "docs:internal:build": "vitepress build docs/internal",
    "docs:public:dev": "vitepress dev docs/public",
    "docs:public:build": "vitepress build docs/public",
    "sync:template": "node scripts/sync-template.mts",
    "release": "changelogen --release --push --no-github",
    "prepare": "test -d .git && simple-git-hooks || true"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@tsconfig/node24": "catalog:",
    "@tsconfig/strictest": "catalog:",
    "@types/node": "catalog:",
    "automd": "catalog:",
    "changelogen": "catalog:",
    "eslint": "catalog:",
    "jiti": "catalog:",
    "lint-staged": "catalog:",
    "mermaid": "catalog:",
    "simple-git-hooks": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitepress": "catalog:",
    "vitepress-plugin-llms": "catalog:",
    "vitepress-plugin-mermaid": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged && pnpm docs:portability",
    "commit-msg": "pnpm exec commitlint --edit $1"
  },
  "lint-staged": {
    "*.{ts,mts,tsx,vue}": "eslint --fix"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "subject-max-length": [
        2,
        "always",
        50
      ]
    }
  }
}
