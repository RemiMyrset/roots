# Normalize line endings to LF in the index. Shipped shell hooks and Linux CI
# require LF; CRLF checkouts would break them.
* text=auto eol=lf
*.sh text eol=lf
*.md text

# Lockfile: don't clutter diffs, mark as generated for linguist.
pnpm-lock.yaml -diff linguist-generated=true

# Generated docs artifacts: reviewable but marked generated.
docs/llms.txt linguist-generated=true
docs/llms-full.txt -diff linguist-generated=true
