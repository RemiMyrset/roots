{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'pnpm -w --silent --config.verify-deps-before-run=false run guards || exit 2'",
            "commandWindows": "pnpm -w --silent --config.verify-deps-before-run=false run guards ; exit $((2*!!($true-$?)))",
            "statusMessage": "guards"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pnpm -w --silent --config.verify-deps-before-run=false run session",
            "statusMessage": "writing rules"
          }
        ]
      }
    ]
  }
}
