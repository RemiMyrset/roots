{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm -w --silent run guards",
            "statusMessage": "guards"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm -w --silent run session",
            "statusMessage": "writing rules"
          }
        ]
      }
    ]
  }
}
